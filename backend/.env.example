# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGIN=http://localhost:3001

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://vesperstay:vesperstay@localhost:5432/vesperstay?schema=public

# ─── JWT Authentication ───────────────────────────────────────────────────────
# Use a long, random secret in production (min 32 chars recommended).
JWT_SECRET=change-me-vesperstay-dev-secret-min-32-chars
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=change-me-vesperstay-refresh-secret-min-32
JWT_REFRESH_EXPIRES_IN=7d

# ─── Redis (cache + Redlock concurrency control + BullMQ) ─────────────────────
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# Redlock TTL for booking locks (milliseconds)
REDIS_LOCK_TTL_MS=5000

# ─── Channel Manager auto-sync (@nestjs/schedule) ─────────────────────────────
# Cron expression for pulling OTA iCal feeds. Default: every 15 minutes.
# Shorter = smaller double-booking window, but more requests to the OTAs.
CHANNEL_SYNC_CRON=0 */15 * * * *
# Set to "false" to disable the scheduled auto-sync (manual sync still works).
# Use this so only ONE instance runs the job when scaling horizontally.
CHANNEL_SYNC_ENABLED=true
